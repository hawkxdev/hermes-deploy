# Copy this file to /opt/hermes/data/.env on the target host.
# Populate credentials and identifiers only in the private runtime file.

# Core gateway and Telegram access.
GATEWAY_ALLOW_ALL_USERS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Optional web providers. Keep the selected backend explicit in config.yaml.
TAVILY_API_KEY=
EXA_API_KEY=
PARALLEL_API_KEY=
PARALLEL_SEARCH_MODE=agentic
